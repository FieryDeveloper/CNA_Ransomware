# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Loaded automatically by rag_core.py (api.py, ask.py).

# Neo4j — use bolt:// for a single local instance (neo4j:// tries cluster routing)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# MongoDB Atlas (enables the analytical lane + live insights)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=cna_ransomware

# LLM for answer synthesis (set one). gpt-4o-mini is the default model.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...

# Census API key — OPTIONAL. The frequency model's denominator comes from the static
# SUSB file (https://www2.census.gov/.../us_state_naics_detailedsizes_2022.txt), which
# needs no key. A key is only required if you extend it to the Census data API
# (BDS / ecnsize), which now returns 302 + X-DataWebAPI-KeyError without one.
# Free: https://api.census.gov/data/key_signup.html
# CENSUS_API_KEY=

# Server port
PORT=8090
